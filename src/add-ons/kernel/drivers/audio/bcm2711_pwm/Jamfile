SubDir HAIKU_TOP src add-ons kernel drivers audio bcm2711_pwm ;

UsePrivateKernelHeaders ;
UsePrivateHeaders audio ;
UseLibraryHeaders [ FDirName libfdt ] ;

local libFDTSources =
	fdt.c
	fdt_ro.c
	fdt_strerror.c
;

KernelAddon bcm2711_pwm :
	bcm2711_pwm.cpp
	$(libFDTSources)
;

SEARCH on [ FGristFiles $(libFDTSources) ]
	= [ FDirName $(HAIKU_TOP) src libs libfdt ] ;
