SubDir HAIKU_TOP src system libroot posix string arch arm64 ;

local architectureObject ;
for architectureObject in [ MultiArchSubDirSetup arm64 ] {
	on $(architectureObject) {
		local architecture = $(TARGET_PACKAGING_ARCH) ;

		UsePrivateSystemHeaders ;

		# Arm Optimized Routines; they replace the generic memcpy and memset,
		# musl's memchr, memmove, memrchr, stpcpy, strchr, strchrnul, strcpy,
		# strlen and strnlen, and libroot's memcmp, strcmp, strncmp and strrchr
		# (see the Jamfiles of posix/string, posix/musl/string and
		# runtime_loader).
		MergeObject <$(architecture)>posix_string_arch_$(TARGET_ARCH).o :
			memchr.S
			memcmp.S
			memcpy.S
			memrchr.S
			memset.S
			stpcpy.S
			strchr.S
			strchrnul.S
			strcmp.S
			strcpy.S
			strlen.S
			strncmp.S
			strnlen.S
			strrchr.S
			;
	}
}
